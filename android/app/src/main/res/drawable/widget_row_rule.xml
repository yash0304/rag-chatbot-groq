<?xml version="1.0" encoding="utf-8"?>
<!--
  The faint rule a line of text sits on. Applied as each row's background rather than as a
  tiled page texture, so the lines land exactly under the rows by construction instead of
  drifting out of step whenever a row's height changes.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="-2dp" android:left="-2dp" android:right="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#1A2B2826" />
        </shape>
    </item>
</layer-list>
