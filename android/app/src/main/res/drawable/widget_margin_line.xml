<?xml version="1.0" encoding="utf-8"?>
<!--
  The margin rule down the left of the page. The negative right inset pushes the rectangle's
  right edge out of view, leaving only the dashed left edge visible.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:right="-4dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:dashWidth="3dp"
                android:dashGap="3dp"
                android:color="#73C67139" />
        </shape>
    </item>
</layer-list>
