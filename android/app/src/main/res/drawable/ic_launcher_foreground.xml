<?xml version="1.0" encoding="utf-8"?>
<!-- Compass-star in a rune ring (first design) in warm sunrise colours (second design's
     palette) on the realm-dark background. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- warm sunrise glow -->
    <path
        android:fillColor="#55FFD08A"
        android:pathData="M54,54 a30,30 0 1,0 0.01,0 Z" />

    <!-- rune ring -->
    <path
        android:strokeColor="#FFC24D"
        android:strokeWidth="2.5"
        android:fillColor="#00000000"
        android:pathData="M54,21 a33,33 0 1,0 0.01,0 Z" />

    <!-- compass star, gold-to-sunrise gradient -->
    <path android:pathData="M54,27 L61,47 L81,54 L61,61 L54,81 L47,61 L27,54 L47,47 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="27"
                android:endX="54" android:endY="81">
                <item android:offset="0.0" android:color="#FFE7B0" />
                <item android:offset="0.5" android:color="#FBB042" />
                <item android:offset="1.0" android:color="#F0824A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- inner diagonal star for depth -->
    <path
        android:fillColor="#E07C3A"
        android:pathData="M54,40 L58,50 L68,54 L58,58 L54,68 L50,58 L40,54 L50,50 Z" />

    <!-- center gem -->
    <path
        android:fillColor="#141A2E"
        android:pathData="M54,50 a4,4 0 1,0 0.01,0 Z" />
</vector>
