<?xml version="1.0" encoding="utf-8"?>
<!-- MindQuest / mY mark: a rising sun (hope) between twin peaks that form an "M",
     with the "mY" monogram at the base. Warm sunrise palette. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- sun glow -->
    <path
        android:fillColor="#66FFE3A8"
        android:pathData="M54,48 a19,19 0 1,0 0.01,0 Z" />
    <!-- sun disc (hope) -->
    <path
        android:fillColor="#FFC24D"
        android:pathData="M54,48 a13,13 0 1,0 0.01,0 Z" />

    <!-- twin peaks forming an M (deep indigo silhouette against the dawn) -->
    <path
        android:fillColor="#22335F"
        android:pathData="M15,83 L40,42 L54,64 L68,42 L93,83 Z" />
    <!-- snow-lit peak caps (the light reaching the summits) -->
    <path
        android:fillColor="#FFEFD5"
        android:pathData="M40,42 L46,52 L40,55 L34,52 Z" />
    <path
        android:fillColor="#FFEFD5"
        android:pathData="M68,42 L74,52 L68,55 L62,52 Z" />

    <!-- "mY" monogram, light on the mountain base -->
    <group>
        <path
            android:strokeColor="#FFF4E2" android:strokeWidth="2.4"
            android:strokeLineCap="round" android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M45,80 L45,71 M45,73 C46.5,70.5 49,70.5 49,74 L49,80 M49,74 C50.5,70.5 53,70.5 53,74 L53,80" />
        <path
            android:strokeColor="#FFF4E2" android:strokeWidth="2.4"
            android:strokeLineCap="round" android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M56,70 L60,75 L64,70 M60,75 L60,80" />
    </group>
</vector>
