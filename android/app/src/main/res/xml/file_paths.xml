<?xml version="1.0" encoding="utf-8"?>
<!--
  Two folders, each shared only for one call: attachments with the camera app for one capture,
  and a freshly written backup with whichever app you choose to send it to (Drive, email).
  Nothing else in the app's storage is reachable this way.
-->
<paths>
    <files-path name="attachments" path="attachments/" />
    <cache-path name="backups" path="backups/" />
</paths>
