<?xml version="1.0" encoding="utf-8"?>
<!--
  30 minutes is the shortest period the system honours for updatePeriodMillis, and it only
  exists as a backstop: the app pushes an update whenever a note or quest changes, so the
  widget is normally current long before this fires.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="150dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_today"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
