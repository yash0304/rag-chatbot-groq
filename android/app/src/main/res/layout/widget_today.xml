<?xml version="1.0" encoding="utf-8"?>
<!--
  A sheet of paper standing in a typewriter carriage.

  The page fills the widget and the machine's top edge sits along the bottom: platen roller,
  red body, a row of keys. The sheet is square along its bottom because that is where it
  disappears into the machine.

  The keys are typed circles in a monospace TextView rather than a bitmap. That keeps them
  crisp at any width and, more to the point, avoids tiled bitmaps and exotic drawables —
  RemoteViews inflates only an allowlist of view classes, and an earlier version of this
  widget failed outright because it used a plain <View> for a hairline. Everything here is a
  TextView, an ImageView or a LinearLayout.

  Colours are literal rather than theme tokens — a widget is drawn by the launcher's
  process, where the app's Compose theme does not exist.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <!-- the sheet -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="26dp"
        android:background="@drawable/widget_paper">

        <ImageView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:background="#59C67139"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingEnd="14dp"
            android:paddingTop="11dp"
            android:paddingBottom="6dp">

            <!-- The masthead: tapping the logo or the name opens the app. Rows are reserved
                 for ticking things off, so the two gestures never compete. -->
            <LinearLayout
                android:id="@+id/widget_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_logo"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="7dp"
                    android:src="@drawable/ic_widget_logo"
                    android:contentDescription="Open MindQuest" />

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif-monospace"
                    android:letterSpacing="0.18"
                    android:textColor="#C67139"
                    android:textSize="12sp"
                    android:text="MINDQUEST" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif-monospace"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:textColor="#9A8B78"
                android:textSize="10sp"
                android:text="DUE TODAY" />

            <TextView
                android:id="@+id/widget_rule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="1dp"
                android:fontFamily="serif-monospace"
                android:maxLines="1"
                android:textColor="#D6C7AC"
                android:textSize="11sp"
                android:text="------------------------------------" />

            <TextView
                android:id="@+id/widget_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:fontFamily="serif-monospace"
                android:textColor="#9A8B78"
                android:textSize="12sp"
                android:visibility="gone"
                android:text="-- the road is clear --" />

            <TextView android:id="@+id/widget_row_1"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/widget_row_rule"
                android:paddingTop="5dp" android:paddingBottom="3dp"
                android:maxLines="1" android:ellipsize="end"
                android:fontFamily="serif-monospace"
                android:textColor="#2B2826" android:textSize="12sp" />
            <TextView android:id="@+id/widget_row_2"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/widget_row_rule"
                android:paddingTop="5dp" android:paddingBottom="3dp"
                android:maxLines="1" android:ellipsize="end"
                android:fontFamily="serif-monospace"
                android:textColor="#2B2826" android:textSize="12sp" />
            <TextView android:id="@+id/widget_row_3"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/widget_row_rule"
                android:paddingTop="5dp" android:paddingBottom="3dp"
                android:maxLines="1" android:ellipsize="end"
                android:fontFamily="serif-monospace"
                android:textColor="#2B2826" android:textSize="12sp" />
            <TextView android:id="@+id/widget_row_4"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/widget_row_rule"
                android:paddingTop="5dp" android:paddingBottom="3dp"
                android:maxLines="1" android:ellipsize="end"
                android:fontFamily="serif-monospace"
                android:textColor="#2B2826" android:textSize="12sp" />
            <TextView android:id="@+id/widget_row_5"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/widget_row_rule"
                android:paddingTop="5dp" android:paddingBottom="3dp"
                android:maxLines="1" android:ellipsize="end"
                android:fontFamily="serif-monospace"
                android:textColor="#2B2826" android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- the machine: platen roller, then the body with its keys -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="#3A2420"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:background="@drawable/widget_machine_body"
            android:gravity="center"
            android:fontFamily="serif-monospace"
            android:letterSpacing="0.22"
            android:maxLines="1"
            android:textColor="#F1E2C9"
            android:textSize="9sp"
            android:text="o o o o o o o o o o o o o o o" />
    </LinearLayout>
</FrameLayout>
