<?xml version="1.0" encoding="utf-8"?>
<!--
  A page in a typewriter carriage.

  serif-monospace resolves to Cutive Mono on Android — an actual typewriter face rather than
  the engineered look of Roboto Mono. The rule under each row and the margin down the left
  do the rest. No emoji: colour glyphs are the one thing that never came off a carriage.

  Two constraints this layout has to respect, both of which broke an earlier version:
   * RemoteViews only inflates an allowlist of view classes, and plain <View> is not on it.
     Rules and spacers are ImageViews, which are.
   * Vector drawables in a widget ImageView are unreliable across launchers, so the logo is
     a plain PNG.

  Colours are literal rather than theme tokens — a widget is drawn by the launcher's
  process, where the app's Compose theme does not exist.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <ImageView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:background="#59C67139"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <!-- The masthead: tapping the logo or the name opens the app. Rows are reserved
             for ticking things off, so the two gestures never compete. -->
        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_logo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_widget_logo"
                android:contentDescription="Open MindQuest" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif-monospace"
                android:letterSpacing="0.18"
                android:textColor="#C67139"
                android:textSize="13sp"
                android:text="MINDQUEST" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="1dp"
            android:fontFamily="serif-monospace"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:textColor="#9A8B78"
            android:textSize="10sp"
            android:text="DUE TODAY" />

        <TextView
            android:id="@+id/widget_rule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:fontFamily="serif-monospace"
            android:maxLines="1"
            android:textColor="#D6C7AC"
            android:textSize="11sp"
            android:text="------------------------------------" />

        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:fontFamily="serif-monospace"
            android:textColor="#9A8B78"
            android:textSize="12sp"
            android:visibility="gone"
            android:text="-- the road is clear --" />

    <TextView android:id="@+id/widget_row_1"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/widget_row_rule"
        android:paddingTop="6dp" android:paddingBottom="4dp"
        android:maxLines="1" android:ellipsize="end"
        android:fontFamily="serif-monospace"
        android:textColor="#2B2826" android:textSize="12sp" />
    <TextView android:id="@+id/widget_row_2"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/widget_row_rule"
        android:paddingTop="6dp" android:paddingBottom="4dp"
        android:maxLines="1" android:ellipsize="end"
        android:fontFamily="serif-monospace"
        android:textColor="#2B2826" android:textSize="12sp" />
    <TextView android:id="@+id/widget_row_3"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/widget_row_rule"
        android:paddingTop="6dp" android:paddingBottom="4dp"
        android:maxLines="1" android:ellipsize="end"
        android:fontFamily="serif-monospace"
        android:textColor="#2B2826" android:textSize="12sp" />
    <TextView android:id="@+id/widget_row_4"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/widget_row_rule"
        android:paddingTop="6dp" android:paddingBottom="4dp"
        android:maxLines="1" android:ellipsize="end"
        android:fontFamily="serif-monospace"
        android:textColor="#2B2826" android:textSize="12sp" />
    <TextView android:id="@+id/widget_row_5"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/widget_row_rule"
        android:paddingTop="6dp" android:paddingBottom="4dp"
        android:maxLines="1" android:ellipsize="end"
        android:fontFamily="serif-monospace"
        android:textColor="#2B2826" android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
