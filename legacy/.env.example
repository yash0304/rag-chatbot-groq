# ---- AI provider ----
# stub  = deterministic offline provider (no keys needed, dev/test quality)
# openai = OpenAI Responses API + embeddings (best quality)
# groq  = Groq chat completions (fast; embeddings fall back to local hashing)
AI_PROVIDER=stub
OPENAI_API_KEY=
GROQ_API_KEY=

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me

# ---- Backend (only needed when running outside docker compose) ----
# DATABASE_URL=postgresql+psycopg://mindquest:mindquest@localhost:5432/mindquest
# QDRANT_URL=http://localhost:6333
# REDIS_URL=redis://localhost:6379/0
# VECTOR_BACKEND=qdrant
# CORS_ORIGINS=http://localhost:3000

# ---- Frontend ----
# NEXT_PUBLIC_API_URL=            # empty = same-origin /api/v1 rewrite
